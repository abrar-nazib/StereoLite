<mxfile host="app.diagrams.net"><diagram id="d1" name="planeprop"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="150" height="150" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;parent tile&lt;/b&gt;&lt;br&gt;d, s&lt;sub&gt;x&lt;/sub&gt;, s&lt;sub&gt;y&lt;/sub&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="150" height="30" as="geometry"/></mxCell><mxCell id="c4" style="html=1;strokeColor=#0072B2;strokeWidth=1.2;endArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="200" as="sourcePoint"/><mxPoint x="170" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="s&lt;sub&gt;x&lt;/sub&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#0072B2;" vertex="1" parent="1"><mxGeometry x="150" y="196" width="40" height="16" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;↑2 upsample&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="245" y="108" width="120" height="24" as="geometry"/></mxCell><mxCell id="c7" value="&lt;font style='font-size:8.5px'&gt;Δ = (−¼, −¼)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="100" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;font style='font-size:8.5px'&gt;Δ = (+¼, −¼)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="100" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;font style='font-size:8.5px'&gt;Δ = (−¼, +¼)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="180" width="100" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;font style='font-size:8.5px'&gt;Δ = (+¼, +¼)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="530" y="180" width="100" height="100" as="geometry"/></mxCell><mxCell id="c11" style="html=1;strokeColor=#333333;strokeWidth=1.4;endArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215" y="155" as="sourcePoint"/><mxPoint x="410" y="155" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="d&lt;sub&gt;child&lt;/sub&gt; = 2·bilinear(d)&lt;br&gt; + 2 s&lt;sub&gt;x&lt;/sub&gt; Δx + 2 s&lt;sub&gt;y&lt;/sub&gt; Δy&lt;br&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;slopes shift each child off the parent plane; factor 2 rescales the disparity unit&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="650" y="100" width="300" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>